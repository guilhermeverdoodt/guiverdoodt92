          "parameters": [
            {
              "name": "X-Worker-Secret",
              "value": "={{ $env.PAINEL_WORKER_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"attempt\":{{ $('Webhook Painel').first().json.body.attempts }},\"etapa\":\"transcricao\",\"mensagem\":\"audio extraido\"}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "marcar-transcricao",
      "name": "Marcar transcricao",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "command": "=python3 /opt/painel/scripts/transcrever.py /data/jobs/{{ $('Webhook Painel').first().json.body.job_id }}/audio.wav"
      },
      "id": "transcrever-faster-whisper",
      "name": "Transcrever (faster-whisper)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        940,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// O Execute Command devolve stdout como string; transcrever.py imprime JSON.\nconst stdout = $input.first().json.stdout || '';\nlet dados;\ntry {\n  dados = JSON.parse(stdout);\n} catch (e) {\n  throw new Error('Saida da transcricao nao e JSON: ' + stdout.slice(0, 500));\n}\nif (dados.error) {\n  throw new Error('Transcricao falhou: ' + dados.error);\n}\nif (!dados.text || !dados.text.trim()) {\n  throw new Error('Transcricao vazia — video sem fala ou audio corrompido.');\n}\nreturn [{ json: dados }];"
      },
      "id": "ler-transcricao",
      "name": "Ler transcricao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Webhook Painel').first().json.body.callback_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Worker-Secret",
              "value": "={{ $env.PAINEL_WORKER_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"attempt\":{{ $('Webhook Painel').first().json.body.attempts }},\"etapa\":\"slides\",\"transcript\":{{ JSON.stringify($json.text) }},\"mensagem\":\"transcricao concluida\"}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "salvar-transcricao",
      "name": "Salvar transcricao",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GROQ_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $env.GROQ_MODEL || 'llama-3.3-70b-versatile' }}\",\n  \"temperature\": 0.4,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"Voce transforma a transcricao de um video curto (Reels/TikTok) em um carrossel para Instagram. Responda SOMENTE com JSON valido no formato: {\\\"titulo\\\": \\\"gancho curto para o slide 1\\\", \\\"slides\\\": [{\\\"n\\\": 1, \\\"titulo\\\": \\\"...\\\", \\\"texto\\\": \\\"ate 220 caracteres\\\"}], \\\"cta\\\": \\\"chamada final\\\", \\\"legenda\\\": \\\"legenda do post\\\", \\\"hashtags\\\": [\\\"#...\\\"]}. Gere entre 5 e 8 slides, em portugues do Brasil, mantendo o tom e os argumentos do video. Nao invente dados.\" },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify($('Ler transcricao').first().json.text) }} }\n  ]\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "estruturar-slides-groq",
      "name": "Estruturar slides (Groq)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Groq responde no formato OpenAI; o conteudo vem como string JSON.\nconst resposta = $input.first().json;\nconst bruto = resposta.choices?.[0]?.message?.content;\nif (!bruto) {\n  throw new Error('Groq nao devolveu conteudo: ' + JSON.stringify(resposta).slice(0, 500));\n}\n\nlet slides;\ntry {\n  slides = typeof bruto === 'string' ? JSON.parse(bruto) : bruto;\n} catch (e) {\n  throw new Error('Slides nao vieram em JSON valido: ' + String(bruto).slice(0, 500));\n}\nif (!Array.isArray(slides.slides) || slides.slides.length === 0) {\n  throw new Error('Estrutura de slides invalida: falta o array \"slides\".');\n}\nreturn [{ json: slides }];"
      },
      "id": "normalizar-slides",
      "name": "Normalizar slides",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Webhook Painel').first().json.body.callback_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Worker-Secret",
              "value": "={{ $env.PAINEL_WORKER_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"attempt\":{{ $('Webhook Painel').first().json.body.attempts }},\"etapa\":\"carrossel\",\"slides_json\":{{ JSON.stringify($json) }},\"mensagem\":\"slides estruturados\"}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "salvar-slides",
      "name": "Salvar slides",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
