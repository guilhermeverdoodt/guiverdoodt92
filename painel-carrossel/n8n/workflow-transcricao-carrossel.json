    {
      "parameters": {
        "jsCode": "// Recebe a saida de erro de qualquer no do pipeline e traduz para o\n// vocabulario da API ($prevNode diz qual no mandou o item para ca).\nconst MAPA_ETAPAS = {\n  'Download (yt-dlp)': 'download',\n  'Extrair audio (ffmpeg)': 'audio',\n  'Transcrever (faster-whisper)': 'transcricao',\n  'Ler transcricao': 'transcricao',\n  'Salvar transcricao': 'transcricao',\n  'Estruturar slides (Groq)': 'slides',\n  'Normalizar slides': 'slides',\n  'Salvar slides': 'slides',\n  'Gerar carrossel': 'carrossel',\n  'Marcar concluido': 'carrossel',\n};\n\nconst noFalho = $prevNode.name;\nconst item = $input.first().json;\nconst mensagem =\n  item.error?.message || item.error || item.message || JSON.stringify(item).slice(0, 500);\n\nconst webhook = $('Webhook Painel').first().json.body;\n\nreturn [{ json: {\n  job_id: webhook.job_id,\n  attempt: webhook.attempts,\n  callback_url: webhook.callback_url,\n  etapa: MAPA_ETAPAS[noFalho] || 'dispatch',\n  error: `[${noFalho}] ${String(mensagem).slice(0, 2000)}`,\n} }];"
      },
      "id": "montar-erro",
      "name": "Montar erro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        640
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $json.callback_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Worker-Secret",
              "value": "={{ $env.PAINEL_WORKER_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"attempt\":{{ $json.attempt }},\"status\":\"erro\",\"etapa\":\"{{ $json.etapa }}\",\"error\":{{ JSON.stringify($json.error) }}}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "marcar-erro",
      "name": "Marcar erro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
