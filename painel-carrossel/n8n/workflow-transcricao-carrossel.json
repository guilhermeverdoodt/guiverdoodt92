{
  "name": "Painel — Transcricao e Carrossel",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "painel-carrossel",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-painel",
      "name": "Webhook Painel",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        300
      ],
      "webhookId": "painel-carrossel"
    },
    {
      "parameters": {
        "jsCode": "// Valida a assinatura HMAC enviada pela API (header X-Signature).\n// Sem isso o webhook do n8n seria um endpoint aberto.\nconst crypto = require('crypto');\n\nconst entrada = $input.first().json;\nconst segredo = $env.PAINEL_WORKER_SECRET;\nif (!segredo) {\n  throw new Error('PAINEL_WORKER_SECRET nao definido no ambiente do n8n.');\n}\n\nconst recebida = entrada.headers['x-signature'] || '';\nconst corpo = JSON.stringify(entrada.body);\nconst esperada = 'sha256=' + crypto.createHmac('sha256', segredo).update(corpo, 'utf8').digest('hex');\n\nconst a = Buffer.from(recebida);\nconst b = Buffer.from(esperada);\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) {\n  throw new Error('Assinatura invalida — requisicao rejeitada.');\n}\nif (!entrada.body.job_id || !entrada.body.url || !entrada.body.callback_url) {\n  throw new Error('Payload incompleto: faltam job_id, url ou callback_url.');\n}\n\nreturn [{ json: entrada.body }];"
      },
      "id": "validar-assinatura",
      "name": "Validar assinatura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        300
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Webhook Painel').first().json.body.callback_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Worker-Secret",
              "value": "={{ $env.PAINEL_WORKER_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"attempt\":{{ $('Webhook Painel').first().json.body.attempts }},\"status\":\"processando\",\"etapa\":\"download\",\"mensagem\":\"n8n assumiu o job\"}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "marcar-processando",
      "name": "Marcar processando",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -160,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "command": "=set -e; mkdir -p /data/jobs/{{ $('Webhook Painel').first().json.body.job_id }}; yt-dlp --no-playlist --no-progress --no-warnings -o '/data/jobs/{{ $('Webhook Painel').first().json.body.job_id }}/video.%(ext)s' \"{{ $('Webhook Painel').first().json.body.url }}\""
      },
      "id": "download-yt-dlp",
      "name": "Download (yt-dlp)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        60,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Webhook Painel').first().json.body.callback_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Worker-Secret",
              "value": "={{ $env.PAINEL_WORKER_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"attempt\":{{ $('Webhook Painel').first().json.body.attempts }},\"etapa\":\"audio\",\"mensagem\":\"video baixado\"}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "marcar-audio",
      "name": "Marcar audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "command": "=set -e; ffmpeg -y -loglevel error -i \"$(ls /data/jobs/{{ $('Webhook Painel').first().json.body.job_id }}/video.* | head -n1)\" -vn -ac 1 -ar 16000 /data/jobs/{{ $('Webhook Painel').first().json.body.job_id }}/audio.wav"
      },
      "id": "extrair-audio-ffmpeg",
      "name": "Extrair audio (ffmpeg)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        500,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Webhook Painel').first().json.body.callback_url }}",
        "sendHeaders": true,
