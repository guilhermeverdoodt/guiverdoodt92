# ---------- Banco ----------
# Postgres (Supabase/Neon) em producao:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/painel
DATABASE_URL=sqlite:///./painel.db

# ---------- Autenticacao ----------
# Obrigatorios, sem valor padrao: a API se recusa a subir com valor de
# exemplo ou com menos de 8 caracteres. Gere os seus com:
#   openssl rand -hex 32
# Chave usada pelo dashboard e por qualquer consumidor da API (header X-API-Key).
API_KEY=
# Segredo compartilhado com o n8n (header X-Worker-Secret no PATCH e
# assinatura HMAC X-Signature no webhook de saida).
WORKER_SECRET=

# ---------- n8n ----------
N8N_WEBHOOK_URL=https://seu-n8n.exemplo.com/webhook/painel-carrossel
N8N_TIMEOUT_SECONDS=10

# ---------- Regras ----------
MAX_URLS_PER_REQUEST=20
MAX_ATTEMPTS=3

# ---------- Worker local (scripts/worker_local.py) ----------
# Alternativa ao n8n para testar o pipeline sem orquestrador.
# Aponte N8N_WEBHOOK_URL para ele: http://127.0.0.1:9000/webhook
WORKER_PORT=9000
WORKER_WORK_DIR=/tmp/painel-jobs
# Sem GROQ_API_KEY o job termina na transcricao.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Endpoint que recebe os slides e devolve {"carousel_url": "..."}.
# Sem ele o job termina nos slides.
CARROSSEL_WEBHOOK_URL=
CARROSSEL_API_TOKEN=

# ---------- Dashboard ----------
# Tambem usado para montar o callback_url enviado ao n8n.
API_BASE_URL=http://localhost:8000
