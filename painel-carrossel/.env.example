# ---------- Banco ----------
# Postgres (Supabase/Neon) em producao:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/painel
DATABASE_URL=sqlite:///./painel.db

# ---------- Autenticacao ----------
# Chave usada pelo dashboard e por qualquer consumidor da API (header X-API-Key).
API_KEY=troque-esta-chave
# Segredo compartilhado com o n8n (header X-Worker-Secret no PATCH e
# assinatura HMAC X-Signature no webhook de saida).
WORKER_SECRET=troque-este-segredo

# ---------- n8n ----------
N8N_WEBHOOK_URL=https://seu-n8n.exemplo.com/webhook/painel-carrossel
N8N_TIMEOUT_SECONDS=10

# ---------- Regras ----------
MAX_URLS_PER_REQUEST=20
MAX_ATTEMPTS=3

# ---------- Dashboard ----------
# Tambem usado para montar o callback_url enviado ao n8n.
API_BASE_URL=http://localhost:8000
